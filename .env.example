# Copy this file to .env and fill in the real values.
# .env is gitignored and never committed.

# Atlas connection string: Atlas dashboard -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cwac

# Any long random string. Regenerate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this invalidates every issued token.
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
